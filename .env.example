# Copy to .env and fill in what you use. Everything is optional: without a key the app runs
# fully offline (rule-based extraction, template explanations, in-memory graph).

# LLM for profile extraction, explanations in Telugu/Hindi/English, Q&A and the faithfulness judge.
# Set ONE of these. Groq is preferred when both are set.
GROQ_API_KEY=            # https://console.groq.com/keys (starts with gsk_)
# YM_GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=
# YM_CLAUDE_MODEL=claude-opus-5-5
# YM_LLM_PROVIDER=auto   # auto | groq | anthropic
# YM_LLM=auto            # auto | off

# Neo4j (docker compose up -d neo4j)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=yojanamitra
# YM_GRAPH_BACKEND=auto  # auto | neo4j | memory

# YM_EMBED_MODEL=intfloat/multilingual-e5-small
